{
  "name": "banyan-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Banyan (榕) - a local-first, plugin-based note-taking app for the web",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "dev": "pnpm --filter @banyan/server dev",
    "dev:web": "pnpm --filter @banyan/web dev",
    "web": "pnpm --filter @banyan/server start",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
